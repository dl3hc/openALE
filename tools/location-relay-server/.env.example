# Copy to .env and fill in, or export these directly in your shell/service unit.
# Load with: set -a; source .env; set +a; node server.js   (or use a process
# manager that reads .env, e.g. pm2/systemd EnvironmentFile=).

# Auth: each openALE client generates its own Ed25519 keypair and
# self-registers via POST /api/v1/register; approve it with
#   node admin-cli.js approve <callsign>
# There is no shared secret / token to configure here.

# Optional
PORT=8766
LOCATION_DB_PATH=./location-relay.sqlite
LOCATION_TTL_ONLINE_MIN=15
LOCATION_TTL_RECENT_MIN=60
LOCATION_TTL_STALE_MIN=1440

# Optional — set BOTH to terminate HTTPS natively (node:https, no extra
# dependency) instead of plain HTTP. Leave both unset to keep plain HTTP and
# put a reverse proxy (Caddy/nginx/Traefik) in front instead. See README.md
# for a one-line self-signed cert recipe.
# LOCATION_TLS_CERT_PATH=./cert.pem
# LOCATION_TLS_KEY_PATH=./key.pem
